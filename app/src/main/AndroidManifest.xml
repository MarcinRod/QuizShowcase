<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuizShowcase">

        <!--
        ACTIVITY: Declaration
        Every Activity MUST be declared here or the system will crash with ActivityNotFoundException.
        android:exported="true" is required for the MAIN/LAUNCHER activity (entry point).
        android:label sets the title shown in the Recents screen; references @string/app_name (Resources demo).

        ACTIVITY: configChanges (advanced — usually the WRONG approach)
        Adding android:configChanges tells the system "I'll handle this change myself —
        do NOT recreate the Activity". The Activity's onConfigurationChanged() is called instead.
        This is an escape hatch; prefer rememberSaveable / ViewModel for state survival.

        Example (do NOT add unless you have a specific reason):
            android:configChanges="orientation|screenSize|keyboardHidden"
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.QuizShowcase">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>